            tap-ms = <U_ANTMORPH_MACRO_TAP>;
            // (c)hmod 
            bindings = <&macro_tap &kp H &kp M &kp O &kp D &kp SPACE>;
        };
        amgn_chown: amgn_chown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <U_ANTMORPH_MACRO_WAIT>;
            tap-ms = <U_ANTMORPH_MACRO_TAP>;
