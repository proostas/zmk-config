            // (b)reak
            bindings = <&macro_tap &kp R &kp E &kp A &kp K>;
        };
        // 'C'
        amgn_case: amgn_case {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <U_ANTMORPH_MACRO_WAIT>;
            tap-ms = <U_ANTMORPH_MACRO_TAP>;
